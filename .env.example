# Required for the AI mentor. Create a key at https://console.groq.com
GROQ_API_KEY=

# Optional. Groq retires models over time; override the default (openai/gpt-oss-120b) here.
# GROQ_MODEL=openai/gpt-oss-120b

# Optional. Per-client limits for /api/review (defaults: 5 per minute, 60 per day).
# REVIEW_LIMIT_PER_MINUTE=5
# REVIEW_LIMIT_PER_DAY=60

# Optional. A shared store makes the rate limit hold across serverless instances.
# Create a free Redis database at https://upstash.com and paste its REST credentials.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
